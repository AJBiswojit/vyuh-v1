# Vyuh local environment.
# VITE_USE_MOCK=true  → services read src/mock-data (default for design work)
VITE_USE_MOCK=true
# VITE_MOCK_ERRORS=true → a share of mock calls reject, so error states are real
VITE_MOCK_ERRORS=false
# VITE_MOCK_ERROR_RATE   → that share, 0–1. Defaults to 0.03
VITE_MOCK_ERROR_RATE=0.03
VITE_API_BASE_URL=http://localhost:4000
